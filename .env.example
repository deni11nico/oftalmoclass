# Copy to .env.local for local development. Both values are safe to expose in the
# browser: the chat URL is public, the real secret (Anthropic key) lives in the Worker.

# URL of the deployed Cloudflare Worker, e.g. https://oftalmoclass-chat.<subdomain>.workers.dev
VITE_CHAT_API_URL=

# Optional. Web3Forms access key so the appointment form really emails the clinic.
# Leave empty to keep the form as a local demo (shows a confirmation, sends nothing).
VITE_WEB3FORMS_KEY=
